{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opus55video",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "DATABASE_PROVIDER": "d1",
    "VITE_APP_URL": "https://opus55video.net",
    "VITE_APP_NAME": "opus55video",
    "VITE_APP_DESCRIPTION": "Create cinematic AI videos from text prompts.",
    "VITE_APP_LOGO": "/logo.svg",
    "VITE_DEFAULT_LOCALE": "en"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opus55video-db",
      "database_id": "292a70f8-5d63-42b6-b979-0aadb53e0ba6",
      "migrations_dir": "drizzle"
    }
  ],
  "routes": [{ "pattern": "opus55video.net", "custom_domain": true }]
}
